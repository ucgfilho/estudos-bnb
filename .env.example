# Configurações do Servidor e Banco de Dados Relacional (LGPD)
# Copie este arquivo para .env (que é ignorado pelo Git) e defina seus segredos locais.

PORT=8080
NODE_ENV=production
DB_PATH=/app/data/bnb_estudos.sqlite
SEED_FILE_PATH=/app/data/initial-workspace.seed.json

# Segredo criptográfico para assinatura de tokens JWT (HS256) e criptografia AES-256-GCM em repouso
JWT_SECRET=substitua-por-uma-chave-aleatoria-com-no-minimo-32-bytes

# Credenciais opcionais de bootstrap local (NUNCA faça commit de dados reais no repositório)
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=
DEFAULT_USER_NAME=
